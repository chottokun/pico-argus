# =====================================================================
# Pico Agent System - アプリケーション動作環境変数設定ファイル (.env)
# =====================================================================

# ---------------------------------------------------------------------
# 📷 1. Tapo IPカメラ接続認証情報 (必須)
# ---------------------------------------------------------------------
# Tapoアプリで設定したカメラへのアクセス用アカウント情報およびIPアドレス
TAPO_USER=your_tapo_user
TAPO_PASS=your_tapo_password
TAPO_IP=192.168.0.10

# ---------------------------------------------------------------------
# 📺 2. 常時知覚 ＆ モニター画面表示設定
# ---------------------------------------------------------------------
# 常時知覚サーバー (MCP/CLI) 起動時に OpenCV モニター画面 (Cognitive Surveillance Monitor) を自動表示するか (true / false)
#   - true : サーバー起動直後からデスクトップ上にリアルタイムアノテーション画面を表示
#   - false: バックグラウンドで静かに常時知覚ループのみを実行 (MCPツール呼出時にオンデマンド表示)
SHOW_MONITOR=true

# 起動時にカメラを物理原点(ホーム位置)に自動アライメント移動させるか (true / false)
TAPO_ALIGN_TO_HOME=true

# ---------------------------------------------------------------------
# 🧠 3. Ollama VLM (視覚マルチモーダルLLM) 接続設定
# ---------------------------------------------------------------------
# Ollama サーバーのエンドポイントURL
OLLAMA_BASE_URL=http://localhost:11434

# クロップ精査に使用するマルチモーダル視覚モデル名 (gemma4:e2b などを推奨)
OLLAMA_MODEL=gemma4:e2b

# Ollama への過剰リクエスト制御用 RPM リミット (デフォルト: 12)
OLLAMA_MAX_RPM=12

# ---------------------------------------------------------------------
# 🎯 4. 自律認知・追尾ルール設定 (任意)
# ---------------------------------------------------------------------
# 常時認知で優先追跡・警告ターゲットとするデフォルトルール
TAPO_COGNITION_TARGET_RULE=a person wearing a hat
